{
  "name": "qa-jp-ai-scanner",
  "version": "0.11.0",
  "description": "QA.JP.AI scanner for AI-built web apps: a pre-release check of your own code, and a URL check that shows details only to verified owners.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "qa-scan": "dist/qa-scan.mjs"
  },
  "files": [
    "dist/",
    "rules/",
    "integrations/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "scan": "tsx src/cli.ts"
  },
  "dependencies": {
    "tldts": "^7.4.22",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "author": "iQi <iqi@email.jp.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QAJPAI/qa-jp-ai-scanner.git"
  },
  "bugs": {
    "email": "qa@email.jp.ai"
  }
}
